rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with your Firebase Authentication UID(s). Never grant admin based on a user-editable profile field.
    function isAdmin() { return request.auth != null && request.auth.uid in ['REPLACE_WITH_ADMIN_UID']; }
    function signedIn() { return request.auth != null; }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'client';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    match /clients/{clientId} { allow read, write: if isAdmin(); }
    match /filings/{filingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /documents/{documentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
    }
    match /requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
